<mvc:View controllerName="cacsfiori.invoices.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Shell id="shell">
        <app>
            <Page id="page" title="{i18n>title}" titleAlignment="Center">
                <content>
                    <Panel id="panelShipName" headerText="{i18n>SelectionScreen}">
                    
                        <Label id="labelShipName" labelFor="shipName" text="{i18n>ShipName}" class="sapUiSmallMargin"></Label>
                        <Input id="shipName" value="{selectionScreen>/ShipName}" width="200px" class="sapUiTinyMarginTop"></Input>

                        <Label id="labelCountry" text="{i18n>Country}" class="sapUiSmallMargin"></Label>
                        <Select class="sapUiTinyMarginTop" id="slCountry" 
                                                            selectedKey="{selectionScreen>/CountryKey}" 
                                                            forceSelection="false"
                                                            items="{selectionScreen>/Countries}">
                            <items>
                                <core:Item id="itemCountry" key="{selectionScreen>key}" text="{selectionScreen>text}"></core:Item>
                            </items>
                        </Select>
                        <Button id="btnFilter" 
                                text="{i18n>btnFilter}" 
                                icon="sap-icon://add-filter" 
                                press="onFilter" 
                                class="sapUiTinyMargin"/>
                                
                        <Button id="btnClearFilter"
                                text="{i18n>btnClearFilters}" 
                                icon="sap-icon://clear-filter"
                                press="onClearFilter"
                                class="sapUiTinyMargin"/>
                    </Panel>
                    <Panel id="invoicesPanel">
                        <List id="invoicesList" 
                              headerText="{i18n>invoicesHeaderList}"
                              class="sapUiResponsiveMargin"
                              width="auto"
                              items="{/Invoices}">

                              <items>
                                <ObjectListItem id="objectInvoicesItem" title="{ShipName} - {Country}"
                                                number="{ parts: [ {path: 'ExtendedPrice'},
                                                                   {path: 'selectionScreen>/Currency'}],
                                                          type: 'sap.ui.model.type.Currency',
                                                          formatOptions: {
                                                            showMeasure : false}}"
                                                numberUnit="{selectionScreen>/Currency}"
                                                numberState="{= ${ExtendedPrice} > 100 ? 'Success' : 'Warning'}"></ObjectListItem>
                              </items>
                        </List>
                    </Panel>
                </content>
            </Page>
        </app>
    </Shell>
</mvc:View>